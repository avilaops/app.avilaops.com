model ClientRegistrationRequest {
  id               String    @id @default(cuid())
  nome             String
  email            String
  telefone         String?
  cpfCnpj          String    @map("cpf_cnpj")
  tipoDocumento    String    @map("tipo_documento") // CPF | CNPJ
