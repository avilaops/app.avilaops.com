generator client {
  provider = "prisma-client-js"
  // O build sai desta máquina (Windows) e roda em Debian dentro do container.
  // Sem o alvo Linux o Prisma sobe procurando um engine que não foi gerado e a
  // aplicação morre na primeira consulta, já em produção.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "finance", "operations", "partnerships", "ai_core"]
}

/// Conta de acesso do portal. Guarda equipe e cliente lado a lado — o papel
/// (`role`) diz para onde a pessoa vai, não se ela entra: OWNER e ADMIN caem na
/// operação, CLIENT cai na própria área.
model AdminIdentity {
  id                  String    @id
  nome                String
  cpf                 String    @unique
  email               String
  senhaHash           String    @map("senha_hash")
  senhaProvisoria     Boolean   @map("senha_provisoria")
  /// OWNER | ADMIN | CLIENT
  role                String
  /// Empresa que esta conta representa. Só CLIENT usa: é o que faz a área do
  /// cliente saber o que é dele. Sem relação declarada de propósito —
  /// `organizations` vive no schema `operations` e o vínculo é por id.
  organizationId      String?   @map("organization_id")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  @@map("portal_clients")
  @@schema("public")
}

model BankAccount {
  id          String    @id
  provider    String
  externalId  String    @map("external_id")
  displayName String    @map("display_name")
  environment String
  currency    String    @default("BRL")
  active      Boolean   @default(true)
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  balances     BalanceSnapshot[]
  transactions BankTransaction[]
  syncRuns     BankSyncRun[]

  @@unique([provider, externalId, environment])
  @@map("bank_accounts")
  @@schema("finance")
}

model BalanceSnapshot {
  id               BigInt   @id @default(autoincrement())
  accountId        String   @map("account_id")
  availableBalance Decimal  @map("available_balance") @db.Decimal(14, 2)
  blockedTotal     Decimal? @map("blocked_total") @db.Decimal(14, 2)
  blockedJudicial  Decimal? @map("blocked_judicial") @db.Decimal(14, 2)
  blockedMed       Decimal? @map("blocked_med") @db.Decimal(14, 2)
  capturedAt       DateTime @default(now()) @map("captured_at")

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
  @@map("balance_snapshots")
  @@schema("finance")
}

model BankTransaction {
  id               BigInt   @id @default(autoincrement())
  accountId        String   @map("account_id")
  externalId       String   @map("external_id")
  endToEndId       String?  @map("end_to_end_id")
  txid             String?
  direction        String
  transactionType  String   @map("transaction_type")
  amount           Decimal  @db.Decimal(14, 2)
  currency         String   @default("BRL")
  description      String
  counterpartyName String?  @map("counterparty_name")
  occurredAt       DateTime @map("occurred_at")
  rawHash          String   @map("raw_hash")
  /// EMPRESA, PESSOAL, INTERNO (troca entre saldos próprios) ou INDEFINIDO.
  scope            String   @default("INDEFINIDO")
  /// Quem decidiu o escopo: REGRA, MANUAL ou IMPORTACAO.
  scopeSource      String?  @map("scope_source")
  /// Categoria de origem (a do extrato) preservada para auditoria.
  category         String?
  importedAt       DateTime @default(now()) @map("imported_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  account        BankAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reconciliation Reconciliation?

  @@unique([accountId, externalId])
  @@index([accountId, occurredAt])
  @@index([direction, occurredAt])
  @@index([scope, occurredAt])
  @@index([txid])
  @@map("bank_transactions")
  @@schema("finance")
}

model Reconciliation {
  id            BigInt    @id @default(autoincrement())
  transactionId BigInt    @unique @map("transaction_id")
  status        String    @default("PENDING")
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  note          String?
  confidence    Decimal?  @db.Decimal(5, 4)
  matchSource   String?   @map("match_source")
  reviewedBy    String?   @map("reviewed_by")
  matchedAt     DateTime? @map("matched_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("reconciliations")
  @@schema("finance")
}

model BankSyncRun {
  id              BigInt    @id @default(autoincrement())
  accountId       String    @map("account_id")
  status          String
  scopeDays       Int       @map("scope_days")
  receivedCount   Int       @default(0) @map("received_count")
  sentCount       Int       @default(0) @map("sent_count")
  balanceCaptured Boolean   @default(false) @map("balance_captured")
  errorCode       String?   @map("error_code")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, startedAt])
  @@map("bank_sync_runs")
  @@schema("finance")
}

model FinanceAuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
  @@schema("finance")
}

model LedgerEntry {
  id            BigInt    @id @default(autoincrement())
  direction     String
  status        String    @default("OPEN")
  description   String
  counterparty  String?
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("BRL")
  /// EMPRESA ou PESSOAL: o que separa o caixa da Ávila do caixa do Nicolas.
  scope         String    @default("EMPRESA")
  dueDate       DateTime  @map("due_date")
  paidAt        DateTime? @map("paid_at")
  category      String?
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  note          String?
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([direction, status, dueDate])
  @@index([scope, status, dueDate])
  @@index([dueDate])
  @@map("ledger_entries")
  @@schema("finance")
}

model PartnerPillar {
  id          String   @id
  label       String
  weight      Int
  score       Int      @default(0)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("partner_pillars")
  @@schema("partnerships")
}

model PartnerRoadmapItem {
  id          String    @id @default(cuid())
  phase       String
  label       String
  owner       String?
  done        Boolean   @default(false)
  sortOrder   Int       @map("sort_order")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([phase, sortOrder])
  @@map("partner_roadmap_items")
  @@schema("partnerships")
}

model PartnerCase {
  id         String   @id
  title      String
  competency String
  status     String   @default("NOT_STARTED")
  summary    String?
  metrics    Json     @default("[]")
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("partner_cases")
  @@schema("partnerships")
}

model PartnerDocument {
  id        String   @id @default(cuid())
  title     String
  category  String
  scope     String
  status    String   @default("NOT_STARTED")
  linkUrl   String?  @map("link_url")
  note      String?
  sortOrder Int      @map("sort_order")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, sortOrder])
  @@map("partner_documents")
  @@schema("partnerships")
}

/// Registro de cada chamada ao Ávila AI Core: tokens, custo, latência e
/// resultado. Isolamento por organização/projeto/ambiente é obrigatório em
/// toda leitura — nunca consultar sem filtrar organizationId.
model AiCoreTelemetry {
  id               BigInt   @id @default(autoincrement())
  organizationId   String   @map("organization_id")
  projectId        String   @map("project_id")
  environment      String   @default("production")
  agentId          String   @map("agent_id")
  actorId          String?  @map("actor_id")
  requestId        String   @unique @map("request_id")
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(12, 6)
  latencyMs        Int      @map("latency_ms")
  outcome          String
  errorMessage     String?  @map("error_message")
  toolsInvoked     Json?    @map("tools_invoked")
  /// PRODUCTION (padrão) ou TEST (smoke test de deploy, validação manual) —
  /// consultas de métricas comerciais e orçamento real devem sempre filtrar
  /// source='PRODUCTION'. Registros TEST existem só para trilha auditável.
  source           String   @default("PRODUCTION")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, environment, createdAt])
  @@index([outcome, createdAt])
  @@index([source, createdAt])
  @@map("ai_core_telemetry")
  @@schema("ai_core")
}

/// Pedido de aprovação humana para uma ferramenta WRITE. A chave de
/// idempotência garante que a mesma ação solicitada duas vezes reutiliza o
/// mesmo pedido em vez de criar um novo (bug encontrado e corrigido nos
/// testes unitários do pacote antes desta integração existir).
model AiCoreApproval {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  projectId       String    @map("project_id")
  environment     String    @default("production")
  agentId         String    @map("agent_id")
  actorId         String?   @map("actor_id")
  toolName        String    @map("tool_name")
  idempotencyKey  String    @map("idempotency_key")
  summary         String
  payload         Json
  status          String    @default("PENDING")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  rejectionReason String?   @map("rejection_reason")
  executedAt      DateTime? @map("executed_at")
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, toolName, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([expiresAt, status])
  @@map("ai_core_approvals")
  @@schema("ai_core")
}

/// Teto de gasto por organização/projeto/ambiente/período. O consumo
/// (spentUsd) é atualizado de forma atômica via UPDATE condicional — nunca
/// via leitura seguida de escrita separada, para não permitir que duas
/// chamadas concorrentes estourem o limite juntas.
model AiCoreSpendPolicy {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  environment    String   @default("production")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  limitUsd       Decimal  @map("limit_usd") @db.Decimal(12, 2)
  spentUsd       Decimal  @default(0) @map("spent_usd") @db.Decimal(12, 6)
  blocked        Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, projectId, environment, periodStart])
  @@index([organizationId, environment])
  @@map("ai_core_spend_policies")
  @@schema("ai_core")
}

/// Uma linha por reserva individual de gasto — o rastro auditável do ciclo
/// reservar → confirmar/liberar. AiCoreSpendPolicy.spentUsd é o agregado;
/// esta tabela é o detalhe que permite corrigir esse agregado quando o custo
/// real diverge do estimado, e identificar reservas órfãs (processo morreu
/// entre reservar e confirmar/liberar).
model AiCoreSpendReservation {
  id               String    @id @default(cuid())
  policyId         String    @map("policy_id")
  organizationId   String    @map("organization_id")
  projectId        String    @map("project_id")
  requestId        String    @unique @map("request_id")
  estimatedCostUsd Decimal   @map("estimated_cost_usd") @db.Decimal(12, 6)
  actualCostUsd    Decimal?  @map("actual_cost_usd") @db.Decimal(12, 6)
  status           String    @default("RESERVED")
  /// PRODUCTION (padrão) ou TEST — mesma semântica de AiCoreTelemetry.source.
  source           String    @default("PRODUCTION")
  createdAt        DateTime  @default(now()) @map("created_at")
  resolvedAt       DateTime? @map("resolved_at")

  @@index([status, createdAt])
  @@index([policyId])
  @@index([source, createdAt])
  @@map("ai_core_spend_reservations")
  @@schema("ai_core")
}

/// Registro de cada execução do job de limpeza de reservas órfãs
/// (releaseStaleReservations). Serve tanto como telemetria (quantas
/// reservas foram liberadas, quanto tempo levou) quanto como sinal de
/// alerta — se a última execução tiver status ERROR ou for antiga demais,
/// algo está errado com o agendamento.
model AiCoreCleanupRun {
  id            String    @id @default(cuid())
  maxAgeMs      Int       @map("max_age_ms")
  releasedCount Int?      @map("released_count")
  status        String    @default("RUNNING")
  errorMessage  String?   @map("error_message")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([status, startedAt])
  @@map("ai_core_cleanup_runs")
  @@schema("ai_core")
}

/// Execução de uma suíte de avaliações (evals.ts) contra uma versão de
/// prompt/modelo. Falha crítica registrada aqui é o que bloqueia deploy.
model AiCoreEvalRun {
  id                String   @id @default(cuid())
  organizationId    String?  @map("organization_id")
  projectId         String   @map("project_id")
  suiteName         String   @map("suite_name")
  promptVersion     String?  @map("prompt_version")
  model             String
  total             Int
  passed            Int
  failed            Int
  criticalFailures  Int      @map("critical_failures")
  shouldBlockDeploy Boolean  @map("should_block_deploy")
  resultsJson       Json     @map("results_json")
  runBy             String?  @map("run_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([suiteName, createdAt])
  @@map("ai_core_eval_runs")
  @@schema("ai_core")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  legalName String?  @map("legal_name")
  cpfCnpj   String?  @unique @map("cpf_cnpj")
  cnpjData  Json?    @map("cnpj_data")
  segment   String?
  siteUrl   String?  @map("site_url")
  status    String   @default("ACTIVE")
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brands                   Brand[]
  projects                 Project[]
  tasks                    OperationalTask[]
  approvals                Approval[]
  leads                    Lead[]
  domains                  DomainAsset[]
  deliverables             Deliverable[]
  subscriptions            Subscription[]
  integrationConnections   OrganizationIntegrationConnection[]
  metaBusinessAccounts     MetaBusinessAccount[]
  metaPages                MetaPage[]
  instagramAccounts        InstagramAccount[]
  metaAdAccounts           MetaAdAccount[]
  metaLeadForms            MetaLeadForm[]
  metaLeads                MetaLead[]
  metaCampaignSnapshots    MetaCampaignSnapshot[]
  profile                  OrganizationProfile?
  contacts                 OrganizationContact[]
  addresses                OrganizationAddress[]
  socialProfiles           OrganizationSocialProfile[]
  webPresence              OrganizationWebPresence?
  seoKeywords              OrganizationSeoKeyword[]
  brandAssets              OrganizationBrandAsset[]
  files                    OrganizationFile[]
  organizationIntegrations OrganizationIntegration[]
  onboardingSteps          OrganizationOnboardingStep[]
  serviceOpportunities     OrganizationServiceOpportunity[]
  assistantDocuments       AssistantDocument[]
  newsletterContacts       NewsletterContact[]

  @@index([status, createdAt])
  @@map("organizations")
  @@schema("operations")
}

model OrganizationProfile {
  id                      String   @id @default(cuid())
  organizationId          String   @unique @map("organization_id")
  ownerName               String?  @map("owner_name")
  ownerRole               String?  @map("owner_role")
  phone                   String?
  whatsapp                String?
  email                   String?
  bestContactTime         String?  @map("best_contact_time")
  stateRegistration       String?  @map("state_registration")
  municipalRegistration   String?  @map("municipal_registration")
  /// CPF de quem responde pela empresa. A Efí exige uma pessoa física no
  /// boleto e no cartão mesmo quando quem paga é CNPJ — sem este campo, as
  /// duas formas de pagamento ficam indisponíveis para o cliente.
  responsibleCpf          String?  @map("responsible_cpf")
  companyDescription      String?  @map("company_description")
  servicesOffered         String?  @map("services_offered")
  productsOffered         String?  @map("products_offered")
  commercialDifferentials String?  @map("commercial_differentials")
  serviceArea             String?  @map("service_area")
  postalCode              String?  @map("postal_code")
  street                  String?
  number                  String?
  complement              String?
  district                String?
  city                    String?
  state                   String?
  country                 String?  @default("Brasil")
  internalOwnerName       String?  @map("internal_owner_name")
  nextAction              String?  @map("next_action")
  onboardingStage         String   @default("BASIC") @map("onboarding_stage")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_profiles")
  @@schema("operations")
}

model OrganizationContact {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  type            String   @default("OWNER")
  name            String
  role            String?
  phone           String?
  whatsapp        String?
  email           String?
  bestContactTime String?  @map("best_contact_time")
  isPrimary       Boolean  @default(false) @map("is_primary")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("organization_contacts")
  @@schema("operations")
}

model OrganizationAddress {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  type           String   @default("MAIN")
  postalCode     String?  @map("postal_code")
  street         String?
  number         String?
  complement     String?
  district       String?
  city           String?
  state          String?
  country        String?  @default("Brasil")
  isPrimary      Boolean  @default(false) @map("is_primary")
  source         String?  @default("MANUAL")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("organization_addresses")
  @@schema("operations")
}

