/// Mensalidade de um cliente (levantamento de cobrança recorrente, §3.2).
///
/// Genérica por decisão: vale para a plataforma de restaurantes, saudepet,
/// brilhax e o próximo — o custo de escrever assim é o mesmo do específico, e
/// o específico vira refatoração no banco compartilhado quando o segundo
/// cliente chega.
///
/// `productKey` + `productTenantId` dizem qual conta, dentro de qual produto,
/// esta assinatura paga. É por esse par que o produto pergunta "qual é a minha
/// fatura?" — o produto não conhece `Organization`, e não precisa conhecer.
model Subscription {
  coreContract    CoreContract?
  id              String        @id @default(cuid())
  organizationId  String        @map("organization_id")
  description     String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("BRL")
  /// Dia do vencimento, 1–28. Os dias 29, 30 e 31 não existem em todo mês, e
  /// mensalidade que some em fevereiro é conversa desagradável.
  billingDay      Int           @map("billing_day")
  /// MONTHLY | YEARLY. O anual cobra uma vez por ano, na competência do mês de
  /// aniversário, usando o mesmo `billingDay` para o vencimento. Serviço pago
  /// adiantado por ano (e-mail, domínio) não cabia no modelo mensal: gravar o
  /// valor do ano num campo lido como mensal mentiria o MRR e a tela.
  billingCycle    String        @default("MONTHLY") @map("billing_cycle")
  /// ACTIVE | PAUSED | CANCELLED
  status          String        @default("ACTIVE")
  startedAt       DateTime      @map("started_at")
  endedAt         DateTime?     @map("ended_at")
  productKey      String?       @map("product_key")
  productTenantId String?       @map("product_tenant_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     SubscriptionInvoice[]

  @@unique([productKey, productTenantId])
  @@index([organizationId, status])
  @@map("subscriptions")
  @@schema("operations")
}

/// A fatura de um mês.
///
/// `unique(assinatura, competência)` é o que impede faturar agosto duas vezes
/// quando o job roda de novo — sem isso, ninguém tem coragem de reexecutar.
model SubscriptionInvoice {
  coreLedgerLink  CoreInvoiceLedgerLink?
  coreAllocations CorePaymentAllocation[]
  id              String                  @id @default(cuid())
  subscriptionId  String                  @map("subscription_id")
  /// AAAA-MM. Competência, não data de emissão.
  competence      String
  /// MONTHLY | YEARLY | SETUP. A implantação é cobrada uma vez, no começo, e
  /// não é mensalidade — mas é fatura do mesmo cliente, aparece na mesma tela e
  /// é paga pelos mesmos meios. Separar em outra tabela renderia duas telas e
  /// dois webhooks para a mesma coisa. YEARLY é a recorrente da assinatura
  /// anual: uma por ano, na competência do mês de aniversário.
  kind            String                  @default("MONTHLY")
  amount          Decimal                 @db.Decimal(10, 2)
  dueDate         DateTime                @map("due_date") @db.Date
  /// OPEN | PAID | OVERDUE | CANCELLED
  status          String                  @default("OPEN")
  paidAt          DateTime?               @map("paid_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  subscription Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  charges      SubscriptionCharge[]

  /// A competência sozinha não basta: a implantação e a primeira mensalidade
  /// caem no mesmo mês, e são duas faturas legítimas.
  @@unique([subscriptionId, competence, kind])
  @@index([status, dueDate])
  @@map("subscription_invoices")
  @@schema("operations")
}

/// Uma tentativa de pagamento da fatura, no formato que a EFI devolve.
///
/// Espelha `DeliverableCharge` de propósito: é a mesma integração, e o webhook
/// procura nos dois lugares. Várias por fatura porque o cliente gera PIX,
/// desiste, e no dia seguinte tira um boleto — as duas cobranças existem, e
/// só uma vai ser paga.
model SubscriptionCharge {
  id             String    @id @default(cuid())
  invoiceId      String    @map("invoice_id")
  /// PIX | BOLETO | CARD | PAYPAL
  method         String
  provider       String    @default("MERCADO_PAGO")
  externalId     String?   @map("external_id")
  status         String    @default("CREATED")
  /// O que foi cobrado de fato. No cartão parcelado já inclui o juros — é o
  /// valor que o cliente vê e o que a EFI captura, e guardar o da fatura aqui
  /// faria a conciliação divergir todo mês.
  amount         Decimal   @db.Decimal(10, 2)
  installments   Int       @default(1)
  interestAmount Decimal   @default(0) @map("interest_amount") @db.Decimal(10, 2)
  pixCopyPaste   String?   @map("pix_copy_paste")
  pixQrBase64    String?   @map("pix_qr_base64")
  boletoUrl      String?   @map("boleto_url")
  checkoutUrl    String?   @map("checkout_url")
  boletoBarcode  String?   @map("boleto_barcode")
  expiresAt      DateTime? @map("expires_at")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
  @@index([externalId])
  @@map("subscription_charges")
  @@schema("operations")
}

/// Chave de API: o que deixa automação e agente (Claude, Codex, n8n) falar com
/// o painel sem cookie de navegador.
///
/// O segredo aparece uma vez, na criação; o banco guarda só o SHA-256 dele e um
/// prefixo para reconhecer a chave na lista. A chave age em nome de quem a criou
/// e **só nos escopos dela**: rota que não declara escopo continua exigindo
/// sessão de gente. Revogar é marcar `revogada_em`, nunca apagar — a auditoria
/// aponta para a linha.
model ChaveDeApi {
  id          String    @id @default(cuid())
  nome        String
  /// Começo do segredo (ex.: `avk_3f9a1c2b`), para reconhecer sem revelar.
  prefixo     String    @unique
  /// SHA-256 em hexadecimal do segredo inteiro.
  hash        String    @unique
  escopos     String[]
  /// `portal_clients.id` de quem criou. Se essa conta sair da casa, a chave morre junto.
  criadaPor   String    @map("criada_por")
  ultimoUsoEm DateTime? @map("ultimo_uso_em")
  expiraEm    DateTime? @map("expira_em")
  revogadaEm  DateTime? @map("revogada_em")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([criadaPor])
  @@map("api_keys")
  @@schema("operations")
}

