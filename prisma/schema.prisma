/// A identidade da própria Ávila Ops: o nome e o ícone que aparecem no topo de
/// todas as telas, e que até aqui eram a letra "A" escrita no componente.
///
/// Uma linha só, de propósito (`id` fixo em "casa"): não é uma tabela de
/// marcas — essa é `brands`, e é dos CLIENTES. Aqui é a casa, e casa só tem
/// uma. O singleton evita a pergunta "qual das linhas é a verdadeira", que
/// aparece no dia em que alguém insere a segunda.
///
/// O ícone mora no banco, e não em disco, porque o container é trocado a cada
/// publicação: arquivo gravado no disco do app some no deploy seguinte, e o
/// painel voltaria a mostrar a letra sem ninguém ter mexido em nada.
model IdentidadeDaCasa {
  id          String  @id @default("casa")
  nome        String  @default("Ávila Ops")
  /// image/png, image/jpeg, image/webp ou image/svg+xml. Nulo = sem ícone, e
  /// a tela desenha a inicial do nome, como sempre fez.
  iconeMime   String? @map("icone_mime")
  iconeDados  Bytes?  @map("icone_dados")
  /// Muda a cada troca de ícone. É o que deixa a URL do ícone ser cacheada
  /// para sempre sem o navegador segurar a imagem antiga depois da troca.
  iconeVersao String? @map("icone_versao")

  /// Dados cadastrais e fiscais da casa: o que vai no cabeçalho da nota de
  /// serviço (NFS-e), em contrato e em fatura. Tudo opcional porque a linha
  /// nasce antes de alguém preencher — quem emite nota confere o que falta.
  razaoSocial               String?  @map("razao_social")
  /// Só dígitos.
  cnpj                      String?
  inscricaoMunicipal        String?  @map("inscricao_municipal")
  inscricaoEstadual         String?  @map("inscricao_estadual")
  /// SIMPLES_NACIONAL | MEI | LUCRO_PRESUMIDO | LUCRO_REAL
  regimeTributario          String?  @map("regime_tributario")
  /// CNAE principal, só dígitos.
  cnae                      String?
  /// Item da lista da LC 116/2003, como "1.07". É o que a prefeitura chama de
  /// "código do serviço".
  codigoServico             String?  @map("codigo_servico")
  /// Código de tributação do município, quando a prefeitura usa um próprio.
  codigoTributacaoMunicipal String?  @map("codigo_tributacao_municipal")
  /// Alíquota do ISS em porcentagem: 2.00 = 2%.
  aliquotaIss               Decimal? @map("aliquota_iss") @db.Decimal(5, 2)
  emailFiscal               String?  @map("email_fiscal")
  telefone                  String?
  site                      String?
  cep                       String?
  logradouro                String?
  numero                    String?
  complemento               String?
  bairro                    String?
  municipio                 String?
  uf                        String?
  /// Código IBGE do município (7 dígitos): a NFS-e identifica a cidade por ele.
  codigoMunicipioIbge       String?  @map("codigo_municipio_ibge")

  /// Certificado digital A1 da casa (.pfx + senha), cifrado com a mesma chave
  /// do cofre de credenciais. Nunca em claro: nem o arquivo, nem a senha.
  certificadoCipher String? @map("certificado_cipher")
  /// Titular, CNPJ, emissor e validade lidos do próprio certificado — o que a
  /// tela mostra sem precisar decifrar nada.
  certificadoInfo   Json?   @map("certificado_info")

  atualizadoPor String?  @map("atualizado_por")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("identidade_da_casa")
  @@schema("operations")
}

