/// Dados tributários do cliente: o que a NFS-e e a NF-e exigem do
/// destinatário. Espelha `IdentidadeDaCasa`, que guarda os de quem emite.
///
/// É a fonte canônica da inscrição estadual, da inscrição municipal e do CPF
/// do responsável. As colunas equivalentes em `OrganizationProfile` continuam
/// existindo por compatibilidade, mas não mandam mais.
///
/// O que NÃO mora aqui, de propósito, para não existir em dois lugares: razão
/// social (`Organization.legalName`), CPF/CNPJ (`Organization.cpfCnpj`),
/// situação cadastral e data de abertura (`Organization.cnpjData`, que é a
/// resposta da Receita com origem e data) e endereço (`OrganizationAddress`,
/// tipo FISCAL quando difere do principal).
model DadosFiscaisDoCliente {
  id             String     @id @default(cuid())
  organizationId String     @unique @map("organization_id")
  /// Tem de concordar com o documento em `Organization.cpfCnpj`: 11 dígitos
  /// para FISICA, 14 para JURIDICA, nenhum para ESTRANGEIRA. Dois gatilhos no
  /// banco garantem isso dos dois lados da relação.
  tipoPessoa     TipoPessoa @default(JURIDICA) @map("tipo_pessoa")

  inscricaoEstadual          String?                     @map("inscricao_estadual")
  inscricaoMunicipal         String?                     @map("inscricao_municipal")
  indicadorInscricaoEstadual IndicadorInscricaoEstadual? @map("indicador_inscricao_estadual")
  regimeTributario           RegimeTributario            @default(NAO_INFORMADO) @map("regime_tributario")
  /// CNAE principal, só dígitos (7). Vem da Receita quando há consulta de CNPJ.
  cnae                       String?
  inscricaoProdutorRural     String?                     @map("inscricao_produtor_rural")
  suframa                    String?
  /// Número de identificação fiscal no exterior. Só com `tipoPessoa`
  /// ESTRANGEIRA — o banco recusa nos outros casos.
  nif                        String?
  /// CPF de quem responde pela empresa. O gateway exige pessoa física no
  /// boleto e no cartão mesmo quando quem paga é CNPJ; sem ele, as duas formas
  /// de pagamento ficam indisponíveis para o cliente.
  cpfResponsavel             String?                     @map("cpf_responsavel")

  /// Item da lista da LC 116/2003 usado nas notas deste cliente, quando
  /// difere do padrão da casa.
  codigoServico      String?  @map("codigo_servico")
  /// ISS retido na fonte. Com ele ligado, a alíquota passa a ser obrigatória:
  /// a prefeitura precisa do percentual para calcular a retenção.
  issRetido          Boolean  @default(false) @map("iss_retido")
  retemIrrf          Boolean  @default(false) @map("retem_irrf")
  retemInss          Boolean  @default(false) @map("retem_inss")
  retemPisCofinsCsll Boolean  @default(false) @map("retem_pis_cofins_csll")
  aliquotaIssRetido  Decimal? @map("aliquota_iss_retido") @db.Decimal(5, 2)

  emailFiscal      String? @map("email_fiscal")
  observacaoFiscal String? @map("observacao_fiscal")
  atualizadoPor    String? @map("atualizado_por")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("dados_fiscais_do_cliente")
  @@schema("operations")
}

