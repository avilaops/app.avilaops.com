  /// Endereço pessoal de quem pede o cadastro, fora dos domínios que a casa
  /// hospeda. Vira o `email_recuperacao` da conta na aprovação.
  emailRecuperacao String?   @map("email_recuperacao")
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  documentos       Json      @default("[]") // [{ key, fileName, mimeType, sizeBytes }]
  motivoRejeicao   String?   @map("motivo_rejeicao")
  revisadoPorId    String?   @map("revisado_por_id")
  revisadoEm       DateTime? @map("revisado_em")
  criadoEm         DateTime  @default(now()) @map("criado_em")

  @@index([status, criadoEm])
  @@map("client_registration_requests")
  @@schema("operations")
}

/// Vaga publicada em jobs.avilaops.com. O site é export estático: ele lê estas
/// vagas no build, não em runtime, porque o JSON-LD JobPosting precisa estar no
/// HTML para o Google Jobs indexar.
model JobPosting {
  id           String    @id @default(cuid())
  slug         String    @unique
  ref          String    @unique
  title        String
  area         String
  team         String
  location     String
  locationType String    @map("location_type") // Presencial | Híbrido | Remoto
  contract     String // Tempo integral | Meio período | Estágio | Freelance | Parceria
  summary      String
  /// Corpo editorial: { intro, responsibilities, expertise, closing, benefits, travel }
  content      Json
  status       String    @default("DRAFT") // DRAFT | PUBLISHED | PAUSED | CLOSED
  postedAt     DateTime? @map("posted_at")
  /// Fim da janela de inscrição. Alimenta o JSON-LD e o filtro da API pública.
  validThrough DateTime? @map("valid_through")
  publishedAt  DateTime? @map("published_at")
  closedAt     DateTime? @map("closed_at")
  createdById  String?   @map("created_by_id")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  applications JobApplication[]

  @@index([status, postedAt])
  @@index([area, status])
  @@map("job_postings")
  @@schema("operations")
}

/// Candidatura recebida pelo formulário do site, via worker jobs-intake.
model JobApplication {
  id             String    @id @default(cuid())
  jobPostingId   String    @map("job_posting_id")
  /// Copiados no ato: a candidatura precisa sobreviver a edição da vaga.
  jobRef         String    @map("job_ref")
  jobTitle       String    @map("job_title")
  nome           String
  email          String
  telefone       String?
  links          String?
  mensagem       String
  stage          String    @default("RECEIVED") // RECEIVED | SCREENING | INTERVIEW | CHALLENGE | OFFER | HIRED | REJECTED | WITHDRAWN
  rating         Int?
  source         String?
  reviewerId     String?   @map("reviewer_id")
  reviewedAt     DateTime? @map("reviewed_at")
  /// LGPD: a página promete 12 meses. Sem coluna, a promessa não é cumprível.
  consentAt      DateTime  @default(now()) @map("consent_at")
  retentionUntil DateTime  @map("retention_until")
  deletedAt      DateTime? @map("deleted_at")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  posting JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  events  JobApplicationEvent[]
  files   JobApplicationFile[]

  @@index([stage, criadoEm])
  @@index([jobPostingId, stage])
  @@index([email])
  @@index([retentionUntil])
  @@map("job_applications")
  @@schema("operations")
}

/// Histórico do funil: mudança de estágio, anotação, e-mail enviado.
model JobApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  actorId       String?  @map("actor_id")
  type          String // STAGE_CHANGED | NOTE | EMAIL_SENT
  fromStage     String?  @map("from_stage")
  toStage       String?  @map("to_stage")
  note          String?
  criadoEm      DateTime @default(now()) @map("criado_em")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, criadoEm])
  @@map("job_application_events")
  @@schema("operations")
}

/// Currículo e portfólio. Storage privado, nunca URL pública.
model JobApplicationFile {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  kind          String   @default("RESUME") // RESUME | PORTFOLIO | OTHER
  storageKey    String   @map("storage_key")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  originalName  String   @map("original_name")
  criadoEm      DateTime @default(now()) @map("criado_em")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("job_application_files")
  @@schema("operations")
}

/// Documento indexado pelo assistente. `organizationId` nulo = conhecimento
/// global da Avila Ops (documentação do repositório, procedimentos, roadmap);
/// preenchido = material daquele cliente e de mais ninguém.
model AssistantDocument {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  /// GLOBAL | TENANT — redundante com o campo acima de propósito, para o
  /// filtro de escopo ser explícito em toda consulta e não depender de NULL.
  scope          String    @default("GLOBAL")
  source         String // REPO_DOC | ROADMAP | ORG_DOSSIER | UPLOAD
  path           String
  title          String
  /// Hash do conteúdo: evita reindexar o que não mudou.
  contentHash    String    @map("content_hash")
  bytes          Int
  indexedAt      DateTime? @map("indexed_at")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       AssistantChunk[]

  @@unique([scope, organizationId, path])
  @@index([scope, organizationId])
  @@index([contentHash])
  @@map("assistant_documents")
  @@schema("ai_core")
}

/// Trecho recuperável. O `organizationId` é copiado do documento de propósito:
/// a consulta de recuperação filtra por ele sem precisar de join, e uma tela
/// nova não consegue vazar entre clientes por esquecer o join.
model AssistantChunk {
  id             String                   @id @default(cuid())
  documentId     String                   @map("document_id")
  organizationId String?                  @map("organization_id")
  scope          String                   @default("GLOBAL")
  ordinal        Int
  heading        String?
  content        String
  tokens         Int
  criadoEm       DateTime                 @default(now()) @map("criado_em")
  /// Coluna GERADA pelo banco (tsvector de `heading` + `content`). Declarada
  /// só para o Prisma não propor apagá-la junto com o índice GIN: o client não
  /// lê nem escreve, quem usa é o SQL cru da busca do assistente.
  busca          Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('portuguese'::regconfig, COALESCE(heading, ''::text)), 'A'::\"char\") || setweight(to_tsvector('portuguese'::regconfig, content), 'B'::\"char\"))"))

  document AssistantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([scope, organizationId])
  @@index([busca], type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], map: "assistant_chunks_content_trgm_idx", type: Gin)
  @@map("assistant_chunks")
  @@schema("ai_core")
}

/// Conversa do assistente. Uma por usuário e assunto; o histórico é o que
/// permite retomar contexto sem reenviar tudo a cada pergunta.
model AssistantConversation {
  id             String    @id @default(cuid())
  actorId        String    @map("actor_id")
  organizationId String?   @map("organization_id")
  title          String
  lastMessageAt  DateTime? @map("last_message_at")
  archivedAt     DateTime? @map("archived_at")
  criadoEm       DateTime  @default(now()) @map("criado_em")

  messages AssistantMessage[]

  @@index([actorId, lastMessageAt])
  @@map("assistant_conversations")
  @@schema("ai_core")
}

/// Mensagem trocada. `citations` guarda quais trechos sustentaram a resposta —
/// sem isso não há como auditar de onde o assistente tirou uma afirmação.
model AssistantMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String // USER | ASSISTANT | SYSTEM
  content        String
  citations      Json?
  model          String?
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  criadoEm       DateTime @default(now()) @map("criado_em")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, criadoEm])
  @@map("assistant_messages")
  @@schema("ai_core")
}

/// Contato da newsletter. Vive separado de `OrganizationContact` de propósito:
/// aquele é o contato operacional de um cliente (quem eu ligo quando o site
/// cai), este é quem consentiu — ou foi importado — para receber e-mail em
/// massa. Misturar os dois faria um descadastro apagar o telefone do dono da
/// empresa.
model NewsletterContact {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  company        String?
  organizationId String?   @map("organization_id")
  /// MANUAL | CLIENTES | GMAIL | IMPORT | FORM
  source         String    @default("MANUAL")
  tags           String[]  @default([])
  /// SUBSCRIBED | UNSUBSCRIBED | BOUNCED
  status         String    @default("SUBSCRIBED")
  lastSeenAt     DateTime? @map("last_seen_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deliveries   NewsletterDelivery[]

  @@index([status, createdAt])
  @@index([organizationId])
  @@map("newsletter_contacts")
  @@schema("operations")
}

/// Campanha de newsletter. `format` decide o que a tela pede e o que o
/// renderizador monta: HTML colado pronto, mensagem em texto ou uma imagem
/// única (peça de social reaproveitada como e-mail).
model NewsletterCampaign {
  id             String    @id @default(cuid())
  name           String
  subject        String
  previewText    String?   @map("preview_text")
  /// HTML | TEXT | IMAGE
  format         String    @default("HTML")
  html           String?
  text           String?
  imageUrl       String?   @map("image_url")
  imageAlt       String?   @map("image_alt")
  imageLinkUrl   String?   @map("image_link_url")
  audienceTags   String[]  @default([]) @map("audience_tags")
  /// DRAFT | SENDING | SENT | FAILED
  status         String    @default("DRAFT")
  recipientCount Int       @default(0) @map("recipient_count")
  sentCount      Int       @default(0) @map("sent_count")
  failedCount    Int       @default(0) @map("failed_count")
  createdById    String?   @map("created_by_id")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  deliveries NewsletterDelivery[]

  @@index([status, createdAt])
  @@map("newsletter_campaigns")
  @@schema("operations")
}

/// Uma linha por destinatário por campanha. É o que impede reenvio duplicado
/// quando um envio falha no meio: a chave única (campanha, e-mail) já existe.
model NewsletterDelivery {
  id         String    @id @default(cuid())
  campaignId String    @map("campaign_id")
  contactId  String?   @map("contact_id")
  email      String
  /// PENDING | SENT | FAILED | SKIPPED
  status     String    @default("PENDING")
  providerId String?   @map("provider_id")
  error      String?
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  campaign NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  NewsletterContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@map("newsletter_deliveries")
  @@schema("operations")
}

/// Estúdio: peça de conteúdo (vídeo ou imagem) montada a partir de um template
/// de src/lib/estudio/templates.ts. Os valores dos campos ficam em JSON porque
/// cada template tem os seus.
model StudioPiece {
  id             String   @id @default(cuid())
  title          String
  /// Cliente dono da peça. Nulo = peça da própria casa, que renderiza com a
  /// MARCA_PADRAO. Com cliente, o Estúdio usa a marca dele (nome, site, logo e
  /// cores vindas do cadastro de identidade).
  organizationId String?  @map("organization_id")
  templateId     String   @map("template_id")
  /// 9:16 | 1:1 | 4:5
  format         String   @default("9:16")
  values         Json
  /// segundos; só vídeo
  duration       Float?
  narration      Boolean  @default(true)
  voice          String   @default("pm_nicolas")
  /// { bpm, semente, db } ou nulo = sem trilha
  soundtrack     Json?
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  renders      StudioRender[]
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@index([organizationId, updatedAt])
  @@map("studio_pieces")
  @@schema("operations")
}

/// Uma renderização pedida ao worker (estudio-worker/). O snapshot congela o
/// pedido: mudar a peça depois não muda o que está na fila.
model StudioRender {
  id         String    @id @default(cuid())
  pieceId    String    @map("piece_id")
  /// video | image
  kind       String
  /// PENDING | RUNNING | DONE | FAILED
  status     String    @default("PENDING")
  width      Int
  height     Int
  fps        Int       @default(24)
  duration   Float?
  snapshot   Json
  fileName   String?   @map("file_name")
  mimeType   String?   @map("mime_type")
  sizeBytes  Int?      @map("size_bytes")
  log        String?
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  piece StudioPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([pieceId, createdAt])
  @@map("studio_renders")
  @@schema("operations")
}

/// Banco de dados que o cliente opera (ERP, PDV, sistema legado), catalogado
/// para análise. O Ávila OS não conecta nele: o servidor de produção não está
/// na rede do cliente. Quem lê a estrutura é um script rodando numa máquina com
/// acesso, que envia o catálogo para `POST /api/organizations/:id/bancos/sync`.
model ClientDatabase {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  /// Identificador estável escolhido por quem sincroniza ("procommerce"). É o
  /// que casa uma nova sincronização com o cadastro que já existe.
  key            String
  name           String
  /// SQLSERVER | POSTGRES | MYSQL | FIREBIRD | ORACLE | OUTRO
  engine         String
  engineVersion  String?   @map("engine_version")
  host           String?
  port           Int?
  databaseName   String    @map("database_name")
  /// PRODUCTION | TEST — de qual base a estrutura foi lida. Cópia de teste
  /// antiga tem contagem de linhas que não vale para a operação.
  environment    String    @default("PRODUCTION")
  /// Como se chega nele: VPN, rede, quem autoriza. Nunca senha.
  accessNotes    String?   @map("access_notes")
  lastSyncedAt   DateTime? @map("last_synced_at")
  /// Máquina que rodou a última sincronização.
  syncedFrom     String?   @map("synced_from")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tables       ClientDatabaseTable[]

  @@unique([organizationId, key])
  @@map("client_databases")
  @@schema("operations")
}

model ClientDatabaseTable {
  id          String   @id @default(cuid())
  databaseId  String   @map("database_id")
  schemaName  String   @map("schema_name")
  name        String
  rowCount    BigInt?  @map("row_count")
  /// Anotação da equipe: o que a tabela guarda. A sincronização nunca escreve
  /// aqui — é o único conteúdo do catálogo que não dá para reler da origem.
  description String?
  /// Última sincronização que encontrou a tabela. Anterior ao `lastSyncedAt`
  /// do banco significa que ela sumiu da origem e só ficou por ter anotação.
  lastSeenAt  DateTime @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  database ClientDatabase         @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  columns  ClientDatabaseColumn[]

  @@unique([databaseId, schemaName, name])
  @@index([databaseId, rowCount])
  @@map("client_database_tables")
  @@schema("operations")
}

model ClientDatabaseColumn {
  id               String   @id @default(cuid())
  tableId          String   @map("table_id")
  name             String
  ordinal          Int
  /// Tipo já formatado como na origem: "varchar(150)", "decimal(18,3)".
  dataType         String   @map("data_type")
  nullable         Boolean
  isPrimaryKey     Boolean  @default(false) @map("is_primary_key")
  referencesTable  String?  @map("references_table")
  referencesColumn String?  @map("references_column")
  /// Estatísticas opcionais, medidas na origem. `filledCount` = linhas não
  /// nulas. Mínimo e máximo só vêm de colunas numéricas e de data: texto
  /// carregaria nome e documento de cliente para dentro deste banco.
  filledCount      BigInt?  @map("filled_count")
  distinctCount    BigInt?  @map("distinct_count")
  minValue         String?  @map("min_value")
  maxValue         String?  @map("max_value")
  description      String?
  lastSeenAt       DateTime @map("last_seen_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  table ClientDatabaseTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@index([name])
  @@map("client_database_columns")
  @@schema("operations")
}

/// Cofre de credenciais da plataforma.
///
/// Guarda o que é segredo **da Ávila Ops**, igual para todos os clientes:
/// `META_APP_SECRET`, chaves do Mercado Pago, consumer keys do X. É a camada
/// que até 17/09/2026 vivia copiada em doze arquivos `.env` pelo parque — ver
/// `docs/inventario-chaves-integracoes.md`.
///
/// Não confundir com `OrganizationIntegrationConnection`, que guarda o token
/// **de cada cliente**. Aquela camada já estava certa e não muda.
///
/// Só OWNER lê valor decifrado (`ehDono()`); a equipe vê metadado e máscara.
model PlatformCredential {
  coreConnections CoreConnection[]
  id              String           @id @default(cuid())
  /// Nome da variável de ambiente, tal como o código lê: `META_APP_ID`.
  chave           String           @unique
  /// meta | whatsapp | instagram | threads | google | mercadopago | mercadolivre | x | bancos | outros
  categoria       String
  rotulo          String?
  descricao       String?
  /// Falso para o que não é segredo (versão da Graph, redirect URI, escopos):
  /// esse valor aparece em tela sem precisar de revelação.
  segredo         Boolean          @default(true)
  /// AES-256-GCM no formato iv.tag.payload, mesma cifra dos tokens da Meta.
  /// A chave de cifra é `CREDENCIAIS_ENCRYPTION_KEY`.
  valorCipher     String?          @map("valor_cipher")
  /// Máscara mostrada na lista sem decifrar nada: "97ad…ead7".
  mascara         String?          @map("mascara")
  /// ATIVO | PENDENTE | APOSENTADA
  /// PENDENTE = catalogada e ainda sem valor. APOSENTADA = nenhum código lê.
  status          String           @default("PENDENTE")
  /// Arquivos que leem esta chave, como apurado pelo inventário. Serve para
  /// saber o que quebra ao girar a credencial.
  consumidores    Json?
  /// De onde o valor veio: "importado:<arquivo>" ou "manual".
  origem          String?
  /// Nome da instituição, para chave de banco cadastrada à mão na tela da
  /// empresa (Nubank, Inter, um banco que o catálogo não conhece). Nulo para
  /// as chaves que o código lê, que se agrupam pela `categoria`.
  grupo           String?
  atualizadoPor   String?          @map("atualizado_por")
  rotacionadoEm   DateTime?        @map("rotacionado_em")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([categoria, status])
  @@map("platform_credentials")
  @@schema("operations")
}

/// Mídia do projeto: imagem, PDF ou vídeo que sustenta o combinado.
///
/// Vive separado de `OrganizationBrandAsset` de propósito. Ativo de marca é
/// identidade do cliente e tem versão e substituição; arquivo de projeto é
/// prova do trabalho, e vários convivem sem um aposentar o outro.
model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
