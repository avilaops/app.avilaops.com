generator client {
  provider      = "prisma-client-js"
  // O build sai desta máquina (Windows) e roda em Debian dentro do container.
  // Sem o alvo Linux o Prisma sobe procurando um engine que não foi gerado e a
  // aplicação morre na primeira consulta, já em produção.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "finance", "operations", "partnerships", "ai_core", "core"]
}

/// Conta de acesso do portal. Guarda equipe e cliente lado a lado — o papel
/// (`role`) diz para onde a pessoa vai, não se ela entra: OWNER e ADMIN caem na
/// operação, CLIENT cai na própria área.
model AdminIdentity {
  coreMemberships     CoreMembership[]
  coreIdentities      CoreIdentityLink[]
  coreAuthorizations  CoreConnection[]
  id                  String             @id
  nome                String
  /// A coluna sempre aceitou nulo (cliente PJ entra por CNPJ, cliente sem
  /// documento entra sem nada) e o modelo dizia o contrário: qualquer consulta
  /// que trouxesse `cpf` estourava para essas contas — na prática, cliente sem
  /// documento nunca conseguia logar. Corrigido em 30/08/2026.
  cpf                 String?
  email               String
  /// Coluna da tabela original do portal; este app não usa.
  telefone            String?
  senhaHash           String             @default("") @map("senha_hash")
  senhaProvisoria     Boolean            @default(false) @map("senha_provisoria")
  /// OWNER | ADMIN | CLIENT
  role                String             @default("CLIENT")
  /// Empresa que esta conta representa. Só CLIENT usa: é o que faz a área do
  /// cliente saber o que é dele. Sem relação declarada de propósito:
  /// `organizations` vive no schema `operations` e o vínculo é por id.
  organizationId      String?            @map("organization_id")
  /// Conta desligada não entra em lugar nenhum e continua no histórico.
  /// Desligar é sempre melhor que apagar: a linha tem pedido e auditoria atrás.
  ativo               Boolean            @default(true)
  atualizadoEm        DateTime?          @map("atualizado_em")
  /// Gravado pelo login. Serve para achar conta esquecida e para auditoria.
  ultimoAcessoEm      DateTime?          @map("ultimo_acesso_em")
  resetTokenHash      String?            @map("reset_token_hash")
  resetTokenExpiresAt DateTime?          @map("reset_token_expires_at")
  /// Endereço pessoal de quem usa a conta, fora dos domínios que hospedamos.
  /// Sem ele a recuperação de senha é circular: o link para voltar a entrar
  /// chega na caixa que a pessoa não consegue abrir. Obrigatório em conta
  /// nova; as antigas ficam nulas até o dono preencher.
  emailRecuperacao    String?            @map("email_recuperacao")

  @@index([ativo])
  @@index([organizationId])
  @@index([role])
  @@map("portal_clients")
  @@schema("public")
}

model BankAccount {
  id          String    @id
  provider    String
  externalId  String    @map("external_id")
  displayName String    @map("display_name")
  environment String
  currency    String    @default("BRL")
  active      Boolean   @default(true)
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  balances     BalanceSnapshot[]
  transactions BankTransaction[]
  syncRuns     BankSyncRun[]

  @@unique([provider, externalId, environment], map: "bank_accounts_provider_external_environment_key")
  @@map("bank_accounts")
  @@schema("finance")
}

model BalanceSnapshot {
  id               BigInt   @id @default(autoincrement())
  accountId        String   @map("account_id")
  availableBalance Decimal  @map("available_balance") @db.Decimal(14, 2)
  blockedTotal     Decimal? @map("blocked_total") @db.Decimal(14, 2)
  blockedJudicial  Decimal? @map("blocked_judicial") @db.Decimal(14, 2)
  blockedMed       Decimal? @map("blocked_med") @db.Decimal(14, 2)
  capturedAt       DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId, capturedAt(sort: Desc)], map: "balance_snapshots_account_captured_idx")
  @@map("balance_snapshots")
  @@schema("finance")
}

model BankTransaction {
  id                   BigInt   @id @default(autoincrement())
  accountId            String   @map("account_id")
  externalId           String   @map("external_id")
  endToEndId           String?  @map("end_to_end_id")
  txid                 String?
  direction            String
  transactionType      String   @map("transaction_type")
  amount               Decimal  @db.Decimal(14, 2)
  currency             String   @default("BRL")
  description          String
  counterpartyName     String?  @map("counterparty_name")
  /// CPF/CNPJ da contraparte, só dígitos. O extrato do Éfi nunca traz; vem do comprovante.
  counterpartyDocument String?  @map("counterparty_document")
  /// Quem decidiu a contraparte: nulo/EFI/IMPORTACAO (extrato) ou COMPROVANTE (identificação humana conferida).
  counterpartySource   String?  @map("counterparty_source")
  occurredAt           DateTime @map("occurred_at") @db.Timestamptz(6)
  rawHash              String   @map("raw_hash")
  /// EMPRESA, PESSOAL, INTERNO (troca entre saldos próprios) ou INDEFINIDO.
  scope                String   @default("INDEFINIDO")
  /// Quem decidiu o escopo: REGRA, MANUAL ou IMPORTACAO.
  scopeSource          String?  @map("scope_source")
  /// Categoria de origem (a do extrato) preservada para auditoria.
  category             String?
  /// Conta do plano de contas. Movimentação sem lançamento entra no DRE por ela.
  accountCode          String?  @map("account_code")
  importedAt           DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account        BankAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reconciliation Reconciliation?

  @@unique([accountId, externalId], map: "bank_transactions_account_external_key")
  @@index([accountId, occurredAt(sort: Desc)], map: "bank_transactions_account_occurred_idx")
  @@index([direction, occurredAt(sort: Desc)], map: "bank_transactions_direction_occurred_idx")
  @@index([scope, occurredAt])
  @@index([txid])
  @@index([accountCode])
  @@map("bank_transactions")
  @@schema("finance")
}

model Reconciliation {
  id            BigInt    @id @default(autoincrement())
  transactionId BigInt    @unique @map("transaction_id")
  status        String    @default("PENDING")
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  note          String?
  confidence    Decimal?  @db.Decimal(5, 4)
  matchSource   String?   @map("match_source")
  reviewedBy    String?   @map("reviewed_by")
  matchedAt     DateTime? @map("matched_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, updatedAt(sort: Desc)], map: "reconciliations_status_updated_idx")
  @@map("reconciliations")
  @@schema("finance")
}

model BankSyncRun {
  id              BigInt    @id @default(autoincrement())
  accountId       String    @map("account_id")
  status          String
  scopeDays       Int       @map("scope_days")
  receivedCount   Int       @default(0) @map("received_count")
  sentCount       Int       @default(0) @map("sent_count")
  balanceCaptured Boolean   @default(false) @map("balance_captured")
  errorCode       String?   @map("error_code")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId, startedAt(sort: Desc)], map: "bank_sync_runs_account_started_idx")
  @@map("bank_sync_runs")
  @@schema("finance")
}

model FinanceAuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "audit_events_created_idx")
  @@index([actorId, createdAt(sort: Desc)], map: "audit_events_actor_created_idx")
  @@map("audit_events")
  @@schema("finance")
}

model LedgerEntry {
  coreInvoiceLink  CoreInvoiceLedgerLink?
  id               BigInt                 @id @default(autoincrement())
  direction        String
  status           String                 @default("OPEN")
  description      String
  counterparty     String?
  amount           Decimal                @db.Decimal(14, 2)
  currency         String                 @default("BRL")
  /// EMPRESA ou PESSOAL: o que separa o caixa da Ávila do caixa do Nicolas.
  scope            String                 @default("EMPRESA")
  dueDate          DateTime               @map("due_date") @db.Timestamptz(6)
  paidAt           DateTime?              @map("paid_at") @db.Timestamptz(6)
  category         String?
  /// Conta do plano de contas (src/lib/plano-de-contas.ts). É o que agrupa o DRE.
  accountCode      String?                @map("account_code")
  /// Primeiro mês de competência. Nulo = o próprio vencimento.
  competenceStart  DateTime?              @map("competence_start") @db.Timestamptz(6)
  /// Em quantos meses o valor se distribui. Nulo ou 1 = mês único.
  competenceMonths Int?                   @map("competence_months")
  referenceType    String?                @map("reference_type")
  referenceId      String?                @map("reference_id")
  note             String?
  createdBy        String?                @map("created_by")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([direction, status, dueDate], map: "ledger_entries_direction_status_due_idx")
  @@index([scope, status, dueDate])
  @@index([dueDate], map: "ledger_entries_due_idx")
  @@index([accountCode])
  @@map("ledger_entries")
  @@schema("finance")
}

/// Leitura de score de crédito (Serasa, Boa Vista, Quod, SPC ou o que o
/// banco mostra) do CPF do Nicolas ou do CNPJ da Ávila. Nenhum birô abre API
/// para pessoa física: a leitura é registrada à mão ou chega pelo n8n. O
/// documento em si não é gravado; só de quem é (CPF ou CNPJ).
model CreditScoreReading {
  id          BigInt   @id @default(autoincrement())
  /// CPF ou CNPJ.
  subjectKind String   @map("subject_kind")
  /// SERASA, BOA_VISTA, QUOD, SPC ou BANCO.
  bureau      String
  score       Int
  maxScore    Int      @default(1000) @map("max_score")
  readAt      DateTime @map("read_at") @db.Timestamptz(6)
  /// MANUAL (tela) ou N8N (fluxo).
  source      String   @default("MANUAL")
  note        String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectKind, bureau, readAt], map: "credit_score_readings_subject_bureau_read_at_idx")
  @@map("credit_score_readings")
  @@schema("finance")
}

model PartnerPillar {
  id          String   @id
  label       String
  weight      Int
  score       Int      @default(0)
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("partner_pillars")
  @@schema("partnerships")
}

model PartnerRoadmapItem {
  id          String    @id @default(cuid())
  phase       String
  label       String
  owner       String?
  done        Boolean   @default(false)
  sortOrder   Int       @map("sort_order")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phase, sortOrder], map: "partner_roadmap_items_phase_sort_idx")
  @@map("partner_roadmap_items")
  @@schema("partnerships")
}

model PartnerCase {
  id         String   @id
  title      String
  competency String
  status     String   @default("NOT_STARTED")
  summary    String?
  metrics    Json     @default("[]")
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("partner_cases")
  @@schema("partnerships")
}

model PartnerDocument {
  id        String   @id @default(cuid())
  title     String
  category  String
  scope     String
  status    String   @default("NOT_STARTED")
  linkUrl   String?  @map("link_url")
  note      String?
  sortOrder Int      @map("sort_order")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, sortOrder], map: "partner_documents_category_sort_idx")
  @@map("partner_documents")
  @@schema("partnerships")
}

/// Registro de cada chamada ao Ávila AI Core: tokens, custo, latência e
/// resultado. Isolamento por organização/projeto/ambiente é obrigatório em
/// toda leitura — nunca consultar sem filtrar organizationId.
model AiCoreTelemetry {
  id               BigInt   @id @default(autoincrement())
  organizationId   String   @map("organization_id")
  projectId        String   @map("project_id")
  environment      String   @default("production")
  agentId          String   @map("agent_id")
  actorId          String?  @map("actor_id")
  requestId        String   @unique @map("request_id")
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(12, 6)
  latencyMs        Int      @map("latency_ms")
  outcome          String
  errorMessage     String?  @map("error_message")
  toolsInvoked     Json?    @map("tools_invoked")
  /// PRODUCTION (padrão) ou TEST (smoke test de deploy, validação manual) —
  /// consultas de métricas comerciais e orçamento real devem sempre filtrar
  /// source='PRODUCTION'. Registros TEST existem só para trilha auditável.
  source           String   @default("PRODUCTION")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, projectId, createdAt(sort: Desc)], map: "ai_core_telemetry_org_project_created_idx")
  @@index([organizationId, environment, createdAt(sort: Desc)], map: "ai_core_telemetry_org_env_created_idx")
  @@index([outcome, createdAt(sort: Desc)], map: "ai_core_telemetry_outcome_created_idx")
  @@index([source, createdAt(sort: Desc)], map: "ai_core_telemetry_source_created_idx")
  @@map("ai_core_telemetry")
  @@schema("ai_core")
}

/// Pedido de aprovação humana para uma ferramenta WRITE. A chave de
/// idempotência garante que a mesma ação solicitada duas vezes reutiliza o
/// mesmo pedido em vez de criar um novo (bug encontrado e corrigido nos
/// testes unitários do pacote antes desta integração existir).
model AiCoreApproval {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  projectId       String    @map("project_id")
  environment     String    @default("production")
  agentId         String    @map("agent_id")
  actorId         String?   @map("actor_id")
  toolName        String    @map("tool_name")
  idempotencyKey  String    @map("idempotency_key")
  summary         String
  payload         Json
  status          String    @default("PENDING")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")
  executedAt      DateTime? @map("executed_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, toolName, idempotencyKey], map: "ai_core_approvals_project_tool_idempotency_key")
  @@index([organizationId, status, createdAt(sort: Desc)], map: "ai_core_approvals_org_status_created_idx")
  @@index([expiresAt, status], map: "ai_core_approvals_expires_status_idx")
  @@map("ai_core_approvals")
  @@schema("ai_core")
}

/// Teto de gasto por organização/projeto/ambiente/período. O consumo
/// (spentUsd) é atualizado de forma atômica via UPDATE condicional — nunca
/// via leitura seguida de escrita separada, para não permitir que duas
/// chamadas concorrentes estourem o limite juntas.
model AiCoreSpendPolicy {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  environment    String   @default("production")
  periodStart    DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime @map("period_end") @db.Timestamptz(6)
  limitUsd       Decimal  @map("limit_usd") @db.Decimal(12, 2)
  spentUsd       Decimal  @default(0) @map("spent_usd") @db.Decimal(12, 6)
  blocked        Boolean  @default(false)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, projectId, environment, periodStart], map: "ai_core_spend_policies_org_project_env_period_key")
  @@index([organizationId, environment], map: "ai_core_spend_policies_org_env_idx")
  @@map("ai_core_spend_policies")
  @@schema("ai_core")
}

/// Uma linha por reserva individual de gasto — o rastro auditável do ciclo
/// reservar → confirmar/liberar. AiCoreSpendPolicy.spentUsd é o agregado;
/// esta tabela é o detalhe que permite corrigir esse agregado quando o custo
/// real diverge do estimado, e identificar reservas órfãs (processo morreu
/// entre reservar e confirmar/liberar).
model AiCoreSpendReservation {
  id               String    @id @default(cuid())
  policyId         String    @map("policy_id")
  organizationId   String    @map("organization_id")
  projectId        String    @map("project_id")
  requestId        String    @unique @map("request_id")
  estimatedCostUsd Decimal   @map("estimated_cost_usd") @db.Decimal(12, 6)
  actualCostUsd    Decimal?  @map("actual_cost_usd") @db.Decimal(12, 6)
  status           String    @default("RESERVED")
  /// PRODUCTION (padrão) ou TEST — mesma semântica de AiCoreTelemetry.source.
  source           String    @default("PRODUCTION")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)], map: "ai_core_spend_reservations_status_created_idx")
  @@index([policyId], map: "ai_core_spend_reservations_policy_idx")
  @@index([source, createdAt(sort: Desc)], map: "ai_core_spend_reservations_source_created_idx")
  @@map("ai_core_spend_reservations")
  @@schema("ai_core")
}

/// Registro de cada execução do job de limpeza de reservas órfãs
/// (releaseStaleReservations). Serve tanto como telemetria (quantas
/// reservas foram liberadas, quanto tempo levou) quanto como sinal de
/// alerta — se a última execução tiver status ERROR ou for antiga demais,
/// algo está errado com o agendamento.
model AiCoreCleanupRun {
  id            String    @id @default(cuid())
  maxAgeMs      Int       @map("max_age_ms")
  releasedCount Int?      @map("released_count")
  status        String    @default("RUNNING")
  errorMessage  String?   @map("error_message")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([status, startedAt(sort: Desc)], map: "ai_core_cleanup_runs_status_started_idx")
  @@map("ai_core_cleanup_runs")
  @@schema("ai_core")
}

/// Execução de uma suíte de avaliações (evals.ts) contra uma versão de
/// prompt/modelo. Falha crítica registrada aqui é o que bloqueia deploy.
model AiCoreEvalRun {
  id                String   @id @default(cuid())
  organizationId    String?  @map("organization_id")
  projectId         String   @map("project_id")
  suiteName         String   @map("suite_name")
  promptVersion     String?  @map("prompt_version")
  model             String
  total             Int
  passed            Int
  failed            Int
  criticalFailures  Int      @map("critical_failures")
  shouldBlockDeploy Boolean  @map("should_block_deploy")
  resultsJson       Json     @map("results_json")
  runBy             String?  @map("run_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt(sort: Desc)], map: "ai_core_eval_runs_project_created_idx")
  @@index([suiteName, createdAt(sort: Desc)], map: "ai_core_eval_runs_suite_created_idx")
  @@map("ai_core_eval_runs")
  @@schema("ai_core")
}

model Organization {
  socialPublishingProfiles SocialPublishingProfile[]
  coreMemberships          CoreMembership[]
  coreProducts             CoreProduct[]
  coreContracts            CoreContract[]
  coreConnections          CoreConnection[]
  coreAssetGrants          CoreAssetGrant[]
  coreOwnedAssets          CoreExternalAsset[]
  corePayments             CorePayment[]
  id                       String                    @id @default(cuid())
  /// Número único do cliente (6 dígitos, a partir de 100001), usado fora do
  /// sistema: atendimento, cobrança, contratos e infraestrutura. Nunca muda.
  clientNumber             Int                       @unique @default(autoincrement()) @map("client_number")
  name                     String
  slug                     String                    @unique
  legalName                String?                   @map("legal_name")
  cpfCnpj                  String?                   @unique @map("cpf_cnpj")
  cnpjData                 Json?                     @map("cnpj_data")
  /// Retrato do próprio cliente conforme registrado por um fornecedor na NF-e
  /// mais recente recebida por ele (bloco <dest>), gravado pela sincronização
  /// da SEFAZ. Mesma natureza do `cnpj_data`: dado do cliente sobre o cliente.
  /// Item de nota, fornecedor e XML NÃO entram aqui — são dado fiscal de
  /// terceiro e não têm por que morar no cadastro comercial.
  sefazData                Json?                     @map("sefaz_data")
  segment                  String?
  siteUrl                  String?                   @map("site_url")
  status                   String                    @default("ACTIVE")
  timezone                 String                    @default("America/Sao_Paulo")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  brands                   Brand[]
  projects                 Project[]
  tasks                    OperationalTask[]
  approvals                Approval[]
  leads                    Lead[]
  domains                  DomainAsset[]
  deliverables             Deliverable[]
  subscriptions            Subscription[]
  integrationConnections   OrganizationIntegrationConnection[]
  metaBusinessAccounts     MetaBusinessAccount[]
  metaPages                MetaPage[]
  instagramAccounts        InstagramAccount[]
  metaAdAccounts           MetaAdAccount[]
  metaLeadForms            MetaLeadForm[]
  metaLeads                MetaLead[]
  metaCampaignSnapshots    MetaCampaignSnapshot[]
  profile                  OrganizationProfile?
  dadosFiscais             DadosFiscaisDoCliente?
  contacts                 OrganizationContact[]
  addresses                OrganizationAddress[]
  socialProfiles           OrganizationSocialProfile[]
