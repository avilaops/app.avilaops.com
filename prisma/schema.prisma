  @@schema("operations")
}

model OrganizationSocialProfile {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  platform       String
  identifier     String?
  url            String?
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform])
  @@index([platform, status])
  @@map("organization_social_profiles")
  @@schema("operations")
}

model OrganizationSeoKeyword {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  keyword         String
  intent          String?
  locality        String?
  priority        String   @default("MEDIUM")
  estimatedVolume String?  @map("estimated_volume")
  recommendedPage String?  @map("recommended_page")
  status          String   @default("RECOMMENDED")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, priority])
  @@map("organization_seo_keywords")
  @@schema("operations")
}

model OrganizationBrandAsset {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  assetType      String   @map("asset_type")
  name           String?
  url            String?
  storageKey     String?  @map("storage_key")
  format         String?
  mimeType       String?  @map("mime_type")
  dimensions     String?
  sizeBytes      Int?     @map("size_bytes")
  version        String?  @default("1")
  isCurrent      Boolean  @default(true) @map("is_current")
  notes          String?
  uploadedBy     String?  @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")
