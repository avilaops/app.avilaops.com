/// Medicao curta e imutavel de disponibilidade e latencia. O painel conserva
/// 24 horas para desenhar tendencia sem transformar o banco operacional em TSDB.
model ServiceHealthCheck {
  id            BigInt    @id @default(autoincrement())
  serviceKey    String    @map("service_key")
  serviceName   String    @map("service_name")
  serverKey     String    @map("server_key")
  url           String
  status        String
  statusCode    Int?      @map("status_code")
  latencyMs     Int?      @map("latency_ms")
  errorCode     String?   @map("error_code")
  checkedAt     DateTime  @default(now()) @map("checked_at")
  /// Proveniência (desde 16/09/2026). Linhas antigas ficam com null.
  requestId     String?   @map("request_id")
  trigger       String?
  probeServer   String?   @map("probe_server")
  probeVersion  String?   @map("probe_version")
  method        String?
  finalUrl      String?   @map("final_url")
  redirects     Int?
  resolvedIp    String?   @map("resolved_ip")
  dnsMs         Int?      @map("dns_ms")
  connectMs     Int?      @map("connect_ms")
  tlsMs         Int?      @map("tls_ms")
  ttfbMs        Int?      @map("ttfb_ms")
  errorCategory String?   @map("error_category")
  errorMessage  String?   @map("error_message")
  finishedAt    DateTime? @map("finished_at")
  persistedAt   DateTime? @default(now()) @map("persisted_at")

  @@index([serviceKey, checkedAt])
  @@index([status, checkedAt])
  @@map("service_health_checks")
  @@schema("operations")
}

/// Retrato dos recursos do host enviado por um coletor local autenticado.
model ServerHealthSnapshot {
  id                  BigInt    @id @default(autoincrement())
  serverKey           String    @map("server_key")
  serverName          String    @map("server_name")
  cpuPercent          Float     @map("cpu_percent")
  memoryUsedPercent   Float     @map("memory_used_percent")
  memoryAvailableMb   Int       @map("memory_available_mb")
  swapUsedPercent     Float     @map("swap_used_percent")
  diskUsedPercent     Float     @map("disk_used_percent")
  load1               Float     @map("load_1")
  containersRunning   Int       @map("containers_running")
  containersUnhealthy Int       @map("containers_unhealthy")
  /// Hora usada para ordenar: a da medição no host, ou a de chegada quando o coletor antigo não a envia.
  collectedAt         DateTime  @map("collected_at")
  receivedAt          DateTime  @default(now()) @map("received_at")
  /// Proveniência (desde 16/09/2026). Null em leituras do coletor v1.
  observedAt          DateTime? @map("observed_at")
  persistedAt         DateTime? @default(now()) @map("persisted_at")
  requestId           String?   @map("request_id")
  collectorVersion    String?   @map("collector_version")
  hostname            String?
  sourceIp            String?   @map("source_ip")
  containersTotal     Int?      @map("containers_total")
  containersStopped   Int?      @map("containers_stopped")
  raw                 Json?

  @@index([serverKey, collectedAt])
  @@map("server_health_snapshots")
  @@schema("operations")
}

model OrganizationIntegrationConnection {
