# PostgreSQL compartilhado apenas durante a fase inicial.
# Mantenha o valor real em .env.local ou no cofre do ambiente.
DATABASE_URL=

# Segredo exclusivo do app operacional.
APP_JWT_SECRET=

# Token estático usado pelo Prometheus (VPS de observabilidade) para
# autenticar o scrape de /api/metrics. Gerar com: openssl rand -hex 32
METRICS_BEARER_TOKEN=

# Integração Efí em produção. Nunca exponha estas variáveis ao navegador.
EFI_CLIENT_ID_PRODUCAO=
EFI_SECRET_KEY_PRODUCAO=

# Use um caminho montado como secret OU o conteúdo P12 em base64.
EFI_CERTIFICATE_PATH_PRODUCAO=
EFI_CERTIFICATE_P12_BASE64=

# Período padrão de sincronização.
EFI_SYNC_DAYS=90

# Chave PIX usada para receber cobranças de entregáveis (mesma conta/certificado acima).
EFI_PIX_KEY=

# Aplicação separada de Cobranças do Efí (boleto/cartão), com credenciais próprias.
EFI_COBRANCA_CLIENT_ID=
EFI_COBRANCA_CLIENT_SECRET=

# Envio de e-mail transacional (confirmação de pagamento) via Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Onde os arquivos de entregáveis ficam armazenados no servidor (fora do webroot).
DELIVERABLES_STORAGE_PATH=./storage/deliverables

# Usado para montar o link de download enviado por e-mail após o pagamento.
APP_BASE_URL=https://app.avilaops.com

# URL pública canônica do app operacional.
APP_URL=https://app.avilaops.com

# Host que serve a página interna do cliente (/<subdomínio>). Ficava no
# cliente.avilaops.com, desligado em 16/09/2026. Enquanto estiver vazio, o
# dossiê não monta endereço e a publicação da página interna é recusada.
INTERNAL_SITE_BASE_URL=

# Service account do Google (mesma usada pelo TagFlow para GTM/GA4), como JSON
# em uma única linha. Precisa ser adicionada como usuária no Search Console
# da propriedade antes de funcionar.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta Business / Facebook / Instagram.
# META_TOKEN_ENCRYPTION_KEY deve ser um segredo forte, exclusivo deste app.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_REDIRECT_URI=https://app.avilaops.com/api/integrations/meta/oauth/callback
META_OAUTH_SCOPES=business_management,pages_show_list,pages_read_engagement,instagram_basic,ads_read,leads_retrieval
# Cifra do cofre de credenciais (/operacao/credenciais). Girar esta chave
# torna ilegivel tudo que esta no cofre: so troque com plano de remigracao.
CREDENCIAIS_ENCRYPTION_KEY=
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=

# Ávila AI Core (camada central de acesso à OpenAI API).
# Fica DESATIVADO por padrão — deixe em branco/"false" até decidir liberar
# chamadas reais. AI_CORE_TOKEN_ENCRYPTION_KEY deve ser um segredo forte,
# exclusivo deste app (mesmo padrão de META_TOKEN_ENCRYPTION_KEY).
AI_CORE_ENABLED=false
AI_CORE_TOKEN_ENCRYPTION_KEY=

# SSO (auth.avilaops.com) — opcional.
# Sem SSO_JWT_SECRET o app ignora o SSO e só aceita o login por CPF/senha; o
# botão do Google nem aparece na tela. Com o segredo preenchido, o cookie
# `avila_sso` passa a valer como sessão de administrador.
#
# O valor tem de ser IDÊNTICO ao SSO_JWT_SECRET do auth.avilaops.com — é o que
# permite validar a assinatura aqui sem chamar o auth server a cada request.
#
# Só sessão com papel ADMIN entra: quem loga com e-mail de fora do Workspace
# avilaops.com recebe papel CLIENTE e é recusado, mesmo com cookie válido.
SSO_JWT_SECRET=
SSO_BASE_URL=https://auth.avilaops.com

# --- Newsletter -------------------------------------------------------------
# Motor de envio: "resend" (usa RESEND_API_KEY + EMAIL_FROM) ou "n8n" (webhook
# abaixo, com o SMTP guardado no cofre do n8n). Vazio = decide sozinho pelo que
# estiver configurado.
NEWSLETTER_DRIVER=
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=

# Assina os links de descadastro. Trocar invalida todos os links já enviados.
# Se ficar vazio, cai no APP_JWT_SECRET.
NEWSLETTER_SECRET=

# Base pública dos links de descadastro e das imagens de campanha.
# Vazio = usa APP_BASE_URL.
NEWSLETTER_PUBLIC_BASE_URL=

# Onde ficam as imagens enviadas para as campanhas (servidas por rota pública).
NEWSLETTER_STORAGE_PATH=./storage/newsletter

# Estúdio (/operacao/estudio): imagens dos templates e arquivos renderizados.
ESTUDIO_STORAGE_PATH=./storage/estudio
# Token que o estudio-worker (no orquestrador) manda em x-estudio-token para pegar a fila
# e devolver o resultado. A chave de serviço do n8n (SERVICE_JWT_SECRET) também é aceita.
ESTUDIO_WORKER_TOKEN=

# PayPal: trilho de quem paga de fora do Brasil (regra 13 do QUADRO.md).
# A conta Stripe brasileira tem transacao internacional restrita, por isso o
# internacional sai por aqui. Sandbox e producao sao mundos separados: cada um
# tem credencial e webhook proprios.
PAYPAL_AMBIENTE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Sem este id o webhook RECUSA a notificacao, de proposito: nao se libera
# acesso pago confiando em cabecalho nao verificado.
PAYPAL_WEBHOOK_ID=

# Plataforma de lojas (lojas.avilaops.com). A area /lojas e a tela do Mercado
# Pago leem por aqui: a plataforma e dona do estado das lojas e este app nao
# guarda copia dele. Sem o token, as duas telas dizem que nao estao
# configuradas em vez de mostrar zero -- zero seria mentira, nao ausencia.
LOJAS_API_URL=https://lojas.avilaops.com
# Mesmo valor do LOJAS_ADMIN_TOKEN de la: e a chave da API administrativa.
LOJAS_ADMIN_TOKEN=
